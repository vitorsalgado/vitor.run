{
  "name": "vitor.run",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://vitor.run",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-static-paths.mjs && node scripts/rss.mjs && node scripts/sitemap.mjs",
    "lint": "eslint .",
    "new:post": "node scripts/new-post.mjs",
    "preview": "vite preview",
    "site:dev": "vitepress dev site --host 127.0.0.1 --port 5174",
    "content:check": "node scripts/check-content.ts",
    "content:test": "node --test --test-concurrency=1 site/.vitepress/posts.test.ts site/.vitepress/posts-build.test.ts",
    "site:build": "npm run content:check && vue-tsc --noEmit -p tsconfig.site.json && vitepress build site",
    "site:preview": "vitepress preview site --host 127.0.0.1 --port 4176",
    "site:test": "playwright test --config playwright.site.config.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.1.17",
    "buffer": "^6.0.3",
    "disqus-react": "^1.1.7",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.563.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@lucide/vue": "1.66.0",
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "markdown-it": "14.3.3",
    "markdown-it-task-lists": "2.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5",
    "vitepress": "1.6.4",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  }
}
