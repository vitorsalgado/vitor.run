{
  "name": "vitor.run",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://vitor.run",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:drafts": "node scripts/dev.mjs --drafts",
    "new:post": "node scripts/new-post.mjs",
    "content:check": "node scripts/check-content.ts",
    "content:test": "node --test --test-concurrency=1 site/.vitepress/posts.test.ts site/.vitepress/posts-build.test.ts site/.vitepress/seo.test.ts scripts/new-post.test.ts scripts/preview.test.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run content:check && npm run typecheck && vitepress build site",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"{site,src/lib,scripts,e2e}/**/*.{ts,vue,mjs,css}\" \"*.{json,js,ts}\" \".github/workflows/*.yml\" README.md",
    "format:check": "prettier --check \"{site,src/lib,scripts,e2e}/**/*.{ts,vue,mjs,css}\" \"*.{json,js,ts}\" \".github/workflows/*.yml\" README.md",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/vue": "1.66.0",
    "@playwright/test": "^1.58.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "markdown-it": "14.3.3",
    "markdown-it-task-lists": "2.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitepress": "2.0.0-alpha.21",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "overrides": {
    "minimatch": "11.0.3"
  }
}
